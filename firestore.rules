rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'primevideoempresa@gmail.com';
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Visitors collection
    match /visitors/{visitorId} {
      allow read, write: if true; // Allowed for public tracking
      allow list: if isAdmin();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read, write: if true; // Allowed for public tracking
      allow list: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow list: if isAdmin();
    }

    // Daily stats (optional pre-aggregation)
    match /daily_stats/{date} {
      allow read, write: if isAdmin();
    }

    // Game stats
    match /game_stats/{gameId} {
      allow read: if isAdmin() || true; // Allow public read for UI stats if needed
      allow write: if true; 
    }

    // System logs (Auth and Critical errors)
    match /system_logs/{logId} {
      allow create: if true; // Allow anyone to report a failure (so we catch auth failures)
      allow read: if isAdmin();
      allow list: if isAdmin();
    }

    // FCM Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }
  }
}
