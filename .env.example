# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FRONTEND (Vercel)
# ==============================================================================
# VITE_PUBLISHER_API_URL: Public base URL of the Express publishing backend on Railway
# Example: https://cobra-games-jr-backend.up.railway.app
VITE_PUBLISHER_API_URL=""

# ==============================================================================
# BACKEND (Railway)
# ==============================================================================
# PORT: Injected automatically by Railway (defaults to 3000 if unset)
# PORT="3000"

# CORS_ALLOWED_ORIGINS: Optional comma-separated extra origins allowed in addition to
# https://cobra-games-jr.vercel.app (e.g. preview domains).
# CORS_ALLOWED_ORIGINS=""

# FIREBASE_SERVICE_ACCOUNT: Full Firebase Admin Service Account JSON (or base64 JSON)
# Required on Railway so the backend can write game ZIPs to Firebase Storage and read Firestore.
# FIREBASE_SERVICE_ACCOUNT=""

# Optional Firebase overrides (if not using firebase-applet-config.json defaults):
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_DATABASE_ID=""
