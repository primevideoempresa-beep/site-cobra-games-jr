{
  "entities": {
    "Visitor": {
      "title": "Visitor",
      "description": "An anonymous visitor profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstVisit": { "type": "string", "format": "date-time" },
        "lastVisit": { "type": "string", "format": "date-time" },
        "userAgent": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" }
      },
      "required": ["id", "firstVisit", "lastVisit"]
    },
    "Session": {
      "title": "Session",
      "description": "A visitor session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "device": { "type": "string" },
        "browser": { "type": "string" }
      },
      "required": ["id", "visitorId", "startTime"]
    },
    "Event": {
      "title": "Event",
      "description": "A specific action taken by a visitor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "sessionId": { "type": "string" },
        "type": { "type": "string", "enum": ["page_view", "game_click", "game_open", "game_download"] },
        "page": { "type": "string" },
        "gameId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "visitorId", "type", "timestamp"]
    },
    "DailyStats": {
      "title": "Daily Stats",
      "description": "Pre-aggregated statistics for a specific day.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "totalVisitors": { "type": "integer" },
        "totalViews": { "type": "integer" },
        "gameClicks": { "type": "object" }
      },
      "required": ["date"]
    },
    "GameStats": {
      "title": "Game Stats",
      "description": "Aggregated statistics for specific games.",
      "type": "object",
      "properties": {
        "clicks": { "type": "integer" },
        "opens": { "type": "integer" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "Game": {
      "title": "Game",
      "description": "A game in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "stats": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "icon": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "playStoreUrl": { "type": "string" },
        "appStoreUrl": { "type": "string" },
        "iframeUrl": { "type": "string" },
        "version": { "type": "string" },
        "order": { "type": "integer" },
        "isUnderMaintenance": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category"]
    },
    "Banner": {
      "title": "Banner",
      "description": "A promotional banner for the home page carousel.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "badge": { "type": "string" },
        "badgeColor": { "type": "string" },
        "badgeIcon": { "type": "string", "enum": ["sparkles", "flame", "grid"] },
        "title": { "type": "string" },
        "highlight": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetId": { "type": "string" },
        "ctaText": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "integer" }
      },
      "required": ["title", "imageUrl"]
    },
    "AdminSecurity": {
      "title": "AdminSecurity",
      "description": "Security and two-factor authentication configuration for the administrator.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secret": { "type": "string" },
        "backupCodes": { "type": "array" },
        "usedBackupCodes": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "enabledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enabled"]
    },
    "AuthorizedAdmin": {
      "title": "AuthorizedAdmin",
      "description": "An authorized administrator record.",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "uid": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "verified": { "type": "boolean" }
      },
      "required": ["role"]
    }
  },
  "firestore": {
    "/admin_security/{docId}": {
      "schema": "AdminSecurity",
      "description": "Admin security and two-factor authentication configuration."
    },
    "/visitors/{visitorId}": {
      "schema": "Visitor",
      "description": "Collection of anonymous visitors."
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Collection of visitor sessions."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of analytics events."
    },
    "/daily_stats/{date}": {
      "schema": "DailyStats",
      "description": "Aggregated stats per day."
    },
    "/game_stats/{gameId}": {
      "schema": "GameStats",
      "description": "Aggregated stats for each game."
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Catalog of games."
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners."
    },
    "/authorized_admins/{email}": {
      "schema": "AuthorizedAdmin",
      "description": "Whitelist of authorized administrator emails."
    }
  }
}

